// Canton Devkit CCTools campaign — Codespaces devcontainer.
// Docker-in-Docker is what makes the local Canton network possible
// inside a Codespace: canton-devkit itself runs Docker containers
// (validator, sequencer, mediator, database) for the demo network.
// Feature reference verified 2026-11-26:
// ghcr.io/devcontainers/features/docker-in-docker:2
{
  "name": "canton-devkit CCTools",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.vscode-json"
      ]
    }
  }
}
